{
    "name": "opensalt/docker-hostmanager",
    "license": "MIT",
    "type": "project",
    "description": "Update /etc/hosts to access running containers",
    "keywords": ["docker", "hosts"],
    "require": {
        "php": "^8.1",
        "docker-php/docker-php": "^4.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/http-client": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/var-dumper": "^6.4|^7.0|^8.0"
    },
    "bin": [
        "bin/docker-hostmanager"
    ],
    "authors": [
        {
            "name": "Luc Vieillescazes",
            "email": "luc@vieillescazes.net"
        }
    ],
    "autoload": {
        "psr-4": {"DockerHostManager\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Test\\": "tests"}
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
